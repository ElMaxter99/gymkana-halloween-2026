# Supabase (Project Settings → API). La service role key SOLO se usa en el servidor.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Panel del coordinador
ADMIN_PASSWORD=pon-una-contraseña-larga
# Mínimo 32 caracteres aleatorios. Ej: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Telegram (opcional). Si se dejan vacías no se envían avisos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zona horaria para mostrar horas en el panel y en Telegram
EVENT_TIMEZONE=Europe/Madrid

# Límites anti-spam (opcionales)
MAX_PLAYERS_PER_TEAM=20

# Ubicaciones con QR que tiene que encontrar cada equipo
QR_PER_TEAM=2

# Marcador en tiempo real (Supabase Realtime). Es la clave PUBLICABLE (sb_publishable_… o «anon»):
# es pública por diseño y no puede leer ninguna tabla (RLS sin políticas). Solo sirve para escuchar
# el aviso «hay cambios» del canal «marcador». Sin ellas el marcador funciona igual, con sondeo cada 5 s.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
